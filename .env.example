# Local development (recommended if mongodb+srv DNS fails on your network)
MONGODB_URL=mongodb://127.0.0.1:27017
# Then: docker compose up -d

# MongoDB Atlas — prefer standard mongodb:// host list from the Atlas UI if SRV DNS times out.
# MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/heart?retryWrites=true&w=majority

# Optional overrides
# JWT_SECRET_KEY=
# SEED_DEMO_USER=false
